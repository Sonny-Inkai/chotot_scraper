const EVALUATED_TYPES = {
  '0': '⚪ Chưa xử lý', // None
  '1': '🟢 Nên mua',    // Should Buy
  '2': '🟡 Thương lượng', // Negotiable
  '3': '🔴 Không mua'   // Don't Buy
