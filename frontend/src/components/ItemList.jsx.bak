const ItemList = () => {
  const [items, setItems] = useState([]);
  const [selectedItems, setSelectedItems] = useState(new Set());
  const [filters, setFilters] = useState({
    category: '',
    province: '',
    minPrice: '',
    maxPrice: '',
    sortBy: 'newest',
    evaluatedType: '',
    page: 1,
    itemIds: '',
  });
  const [pagination, setPagination] = useState({
    total: 0,
    totalPages: 0,
    currentPage: 1,
    limit: 10
  });
  const [evaluationState, setEvaluationState] = useState({
    itemId: null,
    type: '',
    note: '',
    isOpen: false
  });
  const [bulkEvaluationState, setBulkEvaluationState] = useState({
    isOpen: false,
    jsonInput: '',
    error: null
  });

  // Convert Vietnamese time string to timestamp
  const getTimeInMilliseconds = (timeString) => {
    const now = new Date();
    const number = parseInt(timeString.split(' ')[0]);
    const unit = timeString.split(' ')[1];

    switch (unit) {
      case 'phút':
      case 'phút trước':
        return now.getTime() - (number * 60 * 1000);
      case 'giờ':
      case 'giờ trước':
        return now.getTime() - (number * 60 * 60 * 1000);
      case 'ngày':
      case 'ngày trước':
        return now.getTime() - (number * 24 * 60 * 60 * 1000);
      case 'tuần':
      case 'tuần trước':
        return now.getTime() - (number * 7 * 24 * 60 * 60 * 1000);
      case 'tháng':
      case 'tháng trước':
        return now.getTime() - (number * 30 * 24 * 60 * 60 * 1000);
      case 'năm':
      case 'năm trước':
        return now.getTime() - (number * 365 * 24 * 60 * 60 * 1000);
      default:
        return now.getTime();
    }
  };

  useEffect(() => {
    fetchItems();
  }, [filters]);

  const fetchItems = async () => {
    try {
      // Create a copy of filters to modify
      const params = { ...filters };
      
      // Process itemIds if they exist
      if (params.itemIds) {
        // Split by comma, trim whitespace, and filter out empty strings
        params.itemIds = params.itemIds.split(',')
          .map(id => id.trim())
          .filter(id => id !== '')
          .join(',');
      }
      
      // Remove empty filters
      Object.keys(params).forEach(key => {
        if (params[key] === '') {
          delete params[key];
        }
      });
      
      const response = await axios.get('http://localhost:5001/api/items', { params });
      
      let sortedItems = [...response.data.items];
      
      // Sort items based on selected option - only time-based sorting needs client-side handling
      if (filters.sortBy === 'newest') {
        sortedItems.sort((a, b) => {
          const timeA = getTimeInMilliseconds(a.update_time);
          const timeB = getTimeInMilliseconds(b.update_time);
          return timeB - timeA;
        });
      }
      // All other sorting (price-high, price-low, roi-high) is handled by the server
      
      setItems(sortedItems);
      setPagination(response.data.pagination);
    } catch (error) {
      console.error('Error fetching items:', error);
    }
  };

  const handleCheckboxChange = (itemId) => {
    const newSelected = new Set(selectedItems);
    if (newSelected.has(itemId)) {
      newSelected.delete(itemId);
    } else {
      newSelected.add(itemId);
    }
    setSelectedItems(newSelected);
  };

  const handleSelectAll = (e) => {
    if (e.target.checked) {
      setSelectedItems(new Set(items.map(item => item._id)));
    } else {
      setSelectedItems(new Set());
    }
  };

  const handleFilterChange = (name, value) => {
    setFilters(prev => ({ ...prev, [name]: value }));
  };

  const handleSortChange = (e) => {
      const { name, value } = e.target;
      setFilters(prev => ({ ...prev, [name]: value }));
  };

  const handleGetPrompt = () => {
    const selectedItemsData = items.filter(item => selectedItems.has(item._id));

