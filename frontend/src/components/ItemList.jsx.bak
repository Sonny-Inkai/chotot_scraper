              <div className="item-details">
                <h3>{item.title}</h3>
                <p className="id">{item._id}</p>
                <p className="price">{formatPrice(item.price_num)}</p>
                <p className="location">{item.location.full_location}</p>
                <p className="description">{item.short_des}</p>
                <div className="specs">
